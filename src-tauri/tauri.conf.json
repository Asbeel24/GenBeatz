{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenBeatz",
  "version": "0.2.0",
  "identifier": "com.d4nn9.genbeatz",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GenBeatz",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#111213",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Beat demos from your own sample library",
    "copyright": "© D4nN9",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
